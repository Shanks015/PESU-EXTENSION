{
  "manifest_version": 3,
  "name": "PESU Auto PDF Unlocker",
  "version": "4.1",
  "description": "Replaces locked PESU PDF iframes with a selectable-text OCR viewer, plus dark mode, a 75% attendance helper and PYQ search.",
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "declarativeContent",
    "storage",
    "notifications"
  ],
  "host_permissions": [
    "https://www.pesuacademy.com/*",
    "https://pesuacademy.com/*",
    "https://*.pesuacademy.com/*",
    "https://files.pesuacademy.com/*",
    "http://1.6.83.11:8081/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "PESU Auto PDF Unlocker Active",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.pesuacademy.com/*",
        "https://pesuacademy.com/*",
        "https://*.pesuacademy.com/*"
      ],
      "js": [
        "naming.js",
        "attendance.js",
        "content.js",
        "features.js"
      ],
      "all_frames": true,
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "viewer.html",
        "viewer.js",
        "exporter.js",
        "naming.js",
        "pdf.min.js",
        "pdf.worker.min.js",
        "tesseract.min.js",
        "worker.min.js",
        "tesseract-core.js",
        "tesseract-core.wasm.js",
        "eng.traineddata.gz"
      ],
      "matches": [
        "https://www.pesuacademy.com/*"
      ]
    }
  ]
}